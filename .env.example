# Copy this file to .env and fill in your own values.

# From your Supabase project settings, under API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# From ElevenLabs, scoped to ElevenAgents only, Read and Write.
ELEVENLABS_API_KEY=

# From your Twilio account, once you connect a phone number to the agent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
